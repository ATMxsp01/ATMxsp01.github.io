---
/**
 * 系列索引页：全部系列的总览入口。
 * 纯 SSR 直出：每行 = 系列图标 + 名称 + 状态徽标（连载中/已完结）+ 点线引导 +
 * 最近更新日期 + 文章计数；行点击进入系列页（/series/<slug>/）。
 */
import Card from "@components/atoms/display/Card.svelte";
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import PageHeader from "@components/atoms/display/PageHeader.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { seriesConfig } from "@/config";

if (!seriesConfig.enable) {
	return Astro.redirect("/404/");
}
import { getSeriesCatalog, getSortedPostsList } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getSeriesUrl } from "@utils/url-utils";

interface SeriesIndexItem {
	slug: string;
	title: string;
	status: "ongoing" | "completed";
	count: number;
	latest: Date | null;
}

const catalog = await getSeriesCatalog();
const posts = await getSortedPostsList();

const items: SeriesIndexItem[] = [];
for (const [slug, entity] of catalog) {
	const members = posts.filter((post) => post.data.series === slug);
	const latest = members.reduce<Date | null>((acc, post) => {
		const published = post.data.published;
		return acc === null || published > acc ? published : acc;
	}, null);
	items.push({
		slug,
		title: entity.data.title,
		status: entity.data.status,
		count: members.length,
		latest,
	});
}
items.sort(
	(a, b) => (b.latest?.getTime() ?? 0) - (a.latest?.getTime() ?? 0),
);

const totalPosts = items.reduce((sum, item) => sum + item.count, 0);
const seriesSummary = `${items.length} ${i18n(items.length === 1 ? I18nKey.seriesCount : I18nKey.seriesCounts)} · ${totalPosts} ${i18n(I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.series)} description={seriesSummary} page="series">
	<Card color="var(--card-bg)" radius="l" class="series-index px-8 py-6">
		<PageHeader
			icon="material-symbols:auto-stories-rounded"
			title={i18n(I18nKey.series)}
			subtitle={seriesSummary}
		/>
		{items.length > 0 && (
			<ul class="series-index__list">
				{items.map((item) => (
					<li>
						<a
							class="series-index__row m3-state-layer"
							href={getSeriesUrl(item.slug)}
						>
							<MetaIcon icon="material-symbols:auto-stories-rounded" />
							<span class="series-index__name">{item.title}</span>
							<span
								class="series-index__status"
								data-series-status={item.status}
							>
								{item.status === "completed"
									? i18n(I18nKey.seriesStatusCompleted)
									: i18n(I18nKey.seriesStatusOngoing)}
							</span>
							<span class="series-index__rule" aria-hidden="true"></span>
							{item.latest && (
								<span class="series-index__date">
									{formatDateToYYYYMMDD(item.latest)}
								</span>
							)}
							<span class="series-index__count">{item.count}</span>
						</a>
					</li>
				))}
			</ul>
		)}
		{items.length === 0 && (
			<div class="series-index__empty">
				<span>{i18n(I18nKey.noData)}</span>
			</div>
		)}
	</Card>
</MainGridLayout>

<style lang="stylus">
@import "../styles/breakpoints.styl"

.series-index
	display: block

	&__list
		display: grid
		grid-template-columns: repeat(2, minmax(0, 1fr))
		gap: var(--m3e-space-2) var(--m3e-space-4)
		margin: 0
		padding: 0
		list-style: none

	&__row
		display: flex
		align-items: center
		gap: var(--m3e-space-3)
		min-height: 3.5rem
		padding: var(--m3e-space-3) var(--m3e-space-4)
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-low)
		text-decoration: none
		--m3e-state-color: var(--on-surface)
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			background: unquote("color-mix(in oklab, var(--on-surface) 6%, transparent)")

	&__name
		font: var(--m3e-type-body-large)
		font-weight: 500
		color: var(--on-surface)
		white-space: nowrap
		overflow: hidden
		text-overflow: ellipsis

	&__status
		display: inline-flex
		align-items: center
		padding: 0.125rem 0.625rem
		border-radius: var(--shape-corner-full)
		background: unquote("color-mix(in oklab, var(--primary) 10%, transparent)")
		color: var(--primary)
		font: var(--m3e-type-label-small)
		font-weight: 600
		white-space: nowrap

	&__rule
		flex: 1
		align-self: flex-end
		margin-bottom: 0.35em
		min-width: 0.75rem
		border-bottom: 2px dotted var(--outline-variant)

	&__date
		font: var(--m3e-type-label-small)
		color: var(--on-surface-variant)
		white-space: nowrap

	&__count
		font: var(--m3e-type-title-small)
		font-weight: 600
		font-variant-numeric: tabular-nums
		color: var(--on-surface-variant)
		white-space: nowrap

	&__empty
		display: flex
		align-items: center
		justify-content: center
		min-height: 11rem
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-large)

	@media (max-width: bp-sm - 1px)
		&__list
			grid-template-columns: 1fr
</style>
